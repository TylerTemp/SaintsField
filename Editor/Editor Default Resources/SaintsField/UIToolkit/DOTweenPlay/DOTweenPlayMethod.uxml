<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/today.comes.saintsfield/Editor/Editor%20Default%20Resources/SaintsField/UIToolkit/DOTweenPlay/DOTweenPlayMethodStyle.uss?fileID=7433441132597879392&amp;guid=e47281f0abcad444cbf2f0e3456d7a81&amp;type=3#DOTweenPlayMethodStyle"/>
    <ui:VisualElement name="root">
        <ui:VisualElement name="args" class="args"/>
        <ui:VisualElement name="controls" class="controls">
            <ui:Toggle name="autoPlayToggle" value="true" class="autoPlayToggle"/>
            <ui:VisualElement name="buttonsRoot" class="buttonsRoot" style="flex-grow: 0;">
                <ui:Button name="playButton" class="playButton iconButton"/>
                <ui:Button name="pauseButton" class="iconButton pauseButton"/>
                <ui:Button name="resumeButton" class="iconButton resumeButton"/>
                <ui:Button name="stopButton" class="iconButton stopButton"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
