:root {
    flex-direction: row;
}

.statusIndicatorContainer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
}

.textField {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Border/background sit on the inner input, not on the TextField root. */
.textField .unity-base-text-field__input {
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    margin: 0;
    padding: 0;
}

/* The default theme only recolors the border on focus, but zero it again here
   so a themed focus outline can't reintroduce the box. */
.textField .unity-base-text-field__input:focus {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}


.closeButton {
    background-image: url("project://database/Packages/today.comes.saintsfield/Editor/Editor%20Default%20Resources/SaintsField/close-padding.png?fileID=2800000&guid=36dd69db1bf18b64eb0aa0ef5d34280b&type=3#close-padding");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0,0,0,0);

    flex-grow: 0;
    flex-shrink: 0;

    /*border-left-width: 0;*/
    border-width: 0;

    /*border-top-left-radius: 0;*/
    /*border-bottom-left-radius: 0;*/
    padding: 0;
    margin: 0;
    width: 16px;
}
